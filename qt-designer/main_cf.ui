  <property name="styleSheet">
   <string notr="true">#info_frame {
	border: none;
	border-radius: 5px;
}

#info_frame QLineEdit,
#info_frame QComboBox,
#info_frame QDateEdit,
#info_frame QDoubleSplitBox{
	padding: 4px 5px;
	border: 1px solid #838383;
	border-radius: 2px;
}

#info_frame QLineEdit:focus,
#info_frame QComboBox:focus
 {
	border-color: #0055ff;
}

#result_frame {
	border-radius: 5px;
}

QHeaderView::section{
	border: none;
	border-bottom:1px solid #d0c6ff;
	text-align:left;
	padding: 3px 5px;
}

QTableWidget::Item{
	border-bottom:1px solid #d0c6ff;
	padding-left: 3px;
}

#info_frame QPushButton {
	font-size: 12px;
	padding: 5px 15px;
	border: 2px solid #f0f0f0;
	border-radius: 5px;
	background-color: #84e8f7;
}

#info_frame QPushButton:hover {
	border-color: #4c96f7;
	font-size: 12px;
}

#function_frame QPushButton {
	font-size: 14px;
	padding: 5px 10px;
	border: 2px solid #f0f0f0;
	border-radius: 5px;
	background-color: #84e8f7;
}

#function_frame QPushButton:hover {
	border-color: #4c96f7;
	font-size: 15px;
}

#function_frame #btn_delete {
	background-color: #ff8183;
}

#function_frame #delete_btn:hover {
	border-color: #dc0004;
}</string>
